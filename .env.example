# Netproof keys. Copy to .env and put your real keys in, no quotes, no angle brackets.
# .env is gitignored, never commit it.
# Default provider is gemini; set LLM_PROVIDER=anthropic to use Anthropic instead.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=put-your-anthropic-key-here
GEMINI_API_KEY=put-your-gemini-key-here
GEMINI_MODEL=gemini-4-argon
# Set only one Gemini key: google-genai 3.3.0 prefers GOOGLE_API_KEY over
# GEMINI_API_KEY when both are set.
# GOOGLE_API_KEY=put-your-google-api-key-here
